                        <img src="{{ 'heart.svg' | asset_url }}" alt="Heart icon" width="" height="">
                      </button>

                      <button
                        type="button"
                        class="emoji-btn"
                        data-icon="clover"
                        data-marker="☘"
                        data-svg="{{ 'clover.svg' | asset_url }}"
                      >
                        <img src="{{ 'clover.svg' | asset_url }}" alt="Clover icon" width="" height="">
                      </button>

                      <button
                        type="button"
                        class="emoji-btn"
                        data-icon="spade"
                        data-marker="♠"
                        data-svg="{{ 'spade.svg' | asset_url }}"
                      >
                        <img src="{{ 'spade.svg' | asset_url }}" alt="Spade icon" width="" height="">
                      </button>

                      <button
                        type="button"
                        class="emoji-btn"
                        data-icon="diamond"
                        data-marker="♦"

                          {% assign color_hex = color_entry.hex.value %}

                          <button
                            class="rounded-3 color-btn"
                            type="button"
                            data-color="{{ color_hex }}"
                            style="background: {{ color_hex }};"
                            data-bs-toggle="tooltip"
                            data-bs-placement="bottom"
                            title="{{ color_name }}"
                            data-title="{{ color_name }}"
                            aria-label="{{ color_name }}"
                          ></button>
                        {% endfor %}
                      {% else %}
                        <p>No shoelace colors found. Open the app admin once to create default colors.</p>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="accordion w-100 hidden fade-out" id="summaryOptionsAccordion">
          <button

{{ 'configurator_style.css' | asset_url | stylesheet_tag }}
{{ 'configurator_mobile.css' | asset_url | stylesheet_tag }}

<div id="loader" class="d-flex flex-column gap-3">
  <svg class="spinner" viewBox="0 0 50 50">
    <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="4" />
  </svg>
  <p>Loading...</p>
</div>

<div class="shoelaces-configurator-wrapper">
  <div class="container-fluid w-100 h-100 p-0">
    <canvas id="dubrae-config"></canvas>

    <a class="navbar-brand nav-logo configurator-logo" href="{{ routes.root_url }}">
      {{ block.settings.logo_text }}
    </a>

    <div class="icon-container">
      <button
        id="iconMenuBtn"
        class="icon-menu-toggle"
        type="button"
        aria-label="Open tools menu"
        aria-expanded="false"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

      <div id="iconMenuPanel" class="icon-menu-panel d-flex flex-row gap-4">
        <div class="tooltip-container">
          <button id="previewShoeBtn" type="button" aria-label="Preview shoes">
            <img
              src="{{ 'shoes.svg' | asset_url }}"
              alt="Preview Your Shoes Button"
              class="preview-image"
              width=""
              height=""
            >
          </button>

          <div class="tooltip-text">Preview Your Shoelaces on Jordan Shoes</div>
        </div>

        <div class="tooltip-container">
          <button id="helpBtn" type="button" aria-label="Help">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="40"
              height="40"
              fill="currentColor"
              class="bi bi-question-circle"
              viewBox="0 0 16 16"
            >
              <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
              <path
                d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286m1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94" />
            </svg>
          </button>

          <div class="tooltip-text">Help Button</div>
        </div>

        <div class="tooltip-container">
          <button id="pdfBtn" type="button" aria-label="Download PDF">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="40"
              height="40"
              fill="currentColor"
              class="bi bi-filetype-pdf"
              viewBox="0 0 16 16"
            >
              <path fill-rule="evenodd"
                d="M14 4.5V14a2 2 0 0 1-2 2h-1v-1h1a1 1 0 0 0 1-1V4.5h-2A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v9H2V2a2 2 0 0 1 2-2h5.5zM1.6 11.85H0v3.999h.791v-1.342h.803q.43 0 .732-.173.305-.175.463-.474a1.4 1.4 0 0 0 .161-.677q0-.375-.158-.677a1.2 1.2 0 0 0-.46-.477q-.3-.18-.732-.179m.545 1.333a.8.8 0 0 1-.085.38.57.57 0 0 1-.238.241.8.8 0 0 1-.375.082H.788V12.48h.66q.327 0 .512.181.185.183.185.522m1.217-1.333v3.999h1.46q.602 0 .998-.237a1.45 1.45 0 0 0 .595-.689q.196-.45.196-1.084 0-.63-.196-1.075a1.43 1.43 0 0 0-.589-.68q-.396-.234-1.005-.234zm.791.645h.563q.371 0 .609.152a.9.9 0 0 1 .354.454q.118.302.118.753a2.3 2.3 0 0 1-.068.592 1.1 1.1 0 0 1-.196.422.8.8 0 0 1-.334.252 1.3 1.3 0 0 1-.483.082h-.563zm3.743 1.763v1.591h-.79V11.85h2.548v.653H7.896v1.117h1.606v.638z" />
            </svg>
          </button>

          <div class="tooltip-text">Download in PDF form</div>
        </div>
      </div>
    </div>

    <div id="helpModal" class="help-modal">
      <div class="help-modal-overlay"></div>

      <div class="help-modal-content">
        <button id="closeHelpModal" type="button" class="help-modal-close" aria-label="Close help modal">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="40"
            height="40"
            fill="currentColor"
            class="bi bi-x-circle"
            viewBox="0 0 16 16"
          >
            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
            <path
              d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708" />
          </svg>
        </button>

        <div class="help-modal-left">
          {% if block.settings.help_image != blank %}
            <img
              src="{{ block.settings.help_image | image_url: width: 900 }}"
              alt="Customer support"
              width=""
              height=""
            >
          {% else %}
            <img
              src="https://cdn.shopify.com/s/files/1/0135/5966/0608/files/neon_drip.jpg?v=1613792737"
              alt="Customer support"
              width=""
              height=""
            >
          {% endif %}
        </div>

        <div class="help-modal-right">
          {%- form 'contact', id: 'ContactForm' -%}
            {%- if form.posted_successfully? -%}
              <p class="form-success">Thanks! We'll get back to you soon.</p>
            {%- endif -%}

            {%- if form.errors -%}
              <p class="form-error">{{ form.errors | default_errors }}</p>
            {%- endif -%}

            <h2 class="send-message mb-4">Design not fitting?</h2>
            <p>We’re here to help. Fill out the form below and our team will get back to you shortly.</p>

            <div class="d-flex flex-row gap-4 mb-4">
              <input type="text" class="form-control" name="contact[name]" placeholder="Enter your full name">

              <input type="email" class="form-control" name="contact[email]" placeholder="Enter your email" required>
            </div>

            <div class="mb-4">
              <input type="tel" class="form-control" name="contact[phone]" placeholder="Enter your phone number">
            </div>

            <div class="mb-4">
              <textarea class="form-control" rows="3" name="contact[body]" placeholder="Enter your message"></textarea>
            </div>

            <button type="submit" class="btn btn-custom rounded bg-dark text-white form-button py-3 mt-3">
              Send Message
            </button>
          {%- endform -%}
        </div>
      </div>
    </div>

    <div class="directional-button d-flex gap-3">
      <img
        class="directional-img"
        src="{{ 'arrows.png' | asset_url }}"
        alt="360 Directional Arrow Button"
        width=""
        height=""
      >

      <div class="directional-tooltip">View Front / Back</div>
    </div>

    <div id="viewSideIndicator" class="view-side-indicator" aria-live="polite">Editing Front Side</div>
  </div>

  <div class="options-tab active">
    <div class="container p-0 h-100">
      <div class="d-flex h-100 gap-4 flex-column justify-content-between">
        <div class="accordion w-100" id="productOptionsAccordion">
          <div id="dubraesOnly">
            <div class="accordion-item custom-shadow mb-3">
              <h2 class="accordion-header" id="headingModel">
                <button
                  class="accordion-button collapsed py-4 px-4"
                  type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#collapseModel"
                  aria-expanded="false"
                  aria-controls="collapseModel"
                >
                  <h4 class="mb-0">Select Your Model</h4>
                </button>
              </h2>

              <div id="collapseModel" class="accordion-collapse collapse" aria-labelledby="headingModel">
                <div class="accordion-body px-4 pb-4 gap-4 d-flex flex-column justify-content-center">
                  <div class="color-options d-flex gap-1">
                    <button
                      class="small-dubrae model-btn btn btn-outline-dark option-btn active"
                      type="button"
                      data-model="small"
                    >
                      Flat Shoelaces
                    </button>
                  </div>

                  <div class="d-none flex-column gap-3" aria-hidden="true">
                    <label class="fw-bold py-2 mb-0"> Shoelace Model Position: </label>

                    <div>
                      <label class="form-label small mb-1" for="shoelace-model-x">
                        X: <span data-shoelace-model-value="x">0</span>
                      </label>
                      <input
                        id="shoelace-model-x"
                        class="form-range"
                        type="range"
                        min="-5"
                        max="5"
                        step="0.01"
                        value="0"
                        data-shoelace-model-slider="x"
                      >
                    </div>

                    <div>
                      <label class="form-label small mb-1" for="shoelace-model-y">
                        Y: <span data-shoelace-model-value="y">0</span>
                      </label>
                      <input
                        id="shoelace-model-y"
                        class="form-range"
                        type="range"
                        min="-5"
                        max="5"
                        step="0.01"
                        value="0"
                        data-shoelace-model-slider="y"
                      >
                    </div>

                    <div>
                      <label class="form-label small mb-1" for="shoelace-model-z">
                        Z: <span data-shoelace-model-value="z">0</span>
                      </label>
                      <input
                        id="shoelace-model-z"
                        class="form-range"
                        type="range"
                        min="-5"
                        max="5"
                        step="0.01"
                        value="0"
                        data-shoelace-model-slider="z"
                      >
                    </div>

                    <label class="fw-bold py-2 mb-0"> Shoelace Model Rotation: </label>

                    <div>
                      <label class="form-label small mb-1" for="shoelace-model-rotation-x">
                        X: <span data-shoelace-model-value="rotationX">0</span>
                      </label>
                      <input
                        id="shoelace-model-rotation-x"
                        class="form-range"
                        type="range"
                        min="-180"
                        max="180"
                        step="1"
                        value="0"
                        data-shoelace-model-slider="rotationX"
                      >
                    </div>

                    <div>
                      <label class="form-label small mb-1" for="shoelace-model-rotation-y">
                        Y: <span data-shoelace-model-value="rotationY">0</span>
                      </label>
                      <input
                        id="shoelace-model-rotation-y"
                        class="form-range"
                        type="range"
                        min="-180"
                        max="180"
                        step="1"
                        value="0"
                        data-shoelace-model-slider="rotationY"
                      >
                    </div>

                    <div>
                      <label class="form-label small mb-1" for="shoelace-model-rotation-z">
                        Z: <span data-shoelace-model-value="rotationZ">0</span>
                      </label>
                      <input
                        id="shoelace-model-rotation-z"
                        class="form-range"
                        type="range"
                        min="-180"
                        max="180"
                        step="1"
                        value="0"
                        data-shoelace-model-slider="rotationZ"
                      >
                    </div>
                  </div>

                  <div class="d-none flex-column gap-3" aria-hidden="true">
                    <label class="fw-bold py-2 mb-0"> Shoelace Text Position: </label>

                    <div>
                      <label class="form-label small mb-1" for="shoelace-text-x">
                        Front X: <span data-shoelace-text-value="x">-0.24</span>
                      </label>
                      <input
                        id="shoelace-text-x"
                        class="form-range"
                        type="range"
                        min="-2"
                        max="2"
                        step="0.01"
                        value="-0.24"
                        data-shoelace-text-slider="x"
                      >
                    </div>

                    <div>
                      <label class="form-label small mb-1" for="shoelace-text-back-x">
                        Back X: <span data-shoelace-text-value="backX">-0.1</span>
                      </label>
                      <input
                        id="shoelace-text-back-x"
                        class="form-range"
                        type="range"
                        min="-2"
                        max="2"
                        step="0.01"
                        value="-0.1"
                        data-shoelace-text-slider="backX"
                      >
                    </div>

                    <div>
                      <label class="form-label small mb-1" for="shoelace-text-y">
                        Y: <span data-shoelace-text-value="y">0.02</span>
                      </label>
                      <input
                        id="shoelace-text-y"
                        class="form-range"
                        type="range"
                        min="-2"
                        max="2"
                        step="0.01"
                        value="0.02"
                        data-shoelace-text-slider="y"
                      >
                    </div>

                    <div>
                      <label class="form-label small mb-1" for="shoelace-text-z">
                        Z: <span data-shoelace-text-value="z">0.1</span>
                      </label>
                      <input
                        id="shoelace-text-z"
                        class="form-range"
                        type="range"
                        min="-1"
                        max="1"
                        step="0.01"
                        value="0.1"
                        data-shoelace-text-slider="z"
                      >
                    </div>

                    <label class="fw-bold py-2 mb-0"> Shoelace Text Rotation: </label>

                    <div>
                      <label class="form-label small mb-1" for="shoelace-text-rotation-x">
                        X: <span data-shoelace-text-value="rotationX">90</span>
                      </label>
                      <input
                        id="shoelace-text-rotation-x"
                        class="form-range"
                        type="range"
                        min="-180"
                        max="180"
                        step="1"
                        value="90"
                        data-shoelace-text-slider="rotationX"
                      >
                    </div>

                    <div>
                      <label class="form-label small mb-1" for="shoelace-text-rotation-y">
                        Y: <span data-shoelace-text-value="rotationY">0</span>
                      </label>
                      <input
                        id="shoelace-text-rotation-y"
                        class="form-range"
                        type="range"
                        min="-180"
                        max="180"
                        step="1"
                        value="0"
                        data-shoelace-text-slider="rotationY"
                      >
                    </div>

                    <div>
                      <label class="form-label small mb-1" for="shoelace-text-rotation-z">
                        Z: <span data-shoelace-text-value="rotationZ">0</span>
                      </label>
                      <input
                        id="shoelace-text-rotation-z"
                        class="form-range"
                        type="range"
                        min="-180"
                        max="180"
                        step="1"
                        value="0"
                        data-shoelace-text-slider="rotationZ"
                      >
                    </div>
                  </div>

                  {% comment %}
                    <div class="d-none flex-column gap-4" aria-hidden="true">
                      <label class="fw-bold py-2 mb-0"> Shoelace Placement: </label>

                      {% assign editable_shoelaces = 'shoelace_3,Shoelace 3|shoelace_4,Shoelace 4' | split: '|' %}

                      {% for shoelace_entry in editable_shoelaces %}
                      {% assign shoelace_parts = shoelace_entry | split: ',' %}
                      {% assign shoelace_key = shoelace_parts[0] %}
                      {% assign shoelace_label = shoelace_parts[1] %}
                      {% if shoelace_key == 'shoelace_3' %}
                      {% assign placement_x = '3.62' %}
                      {% assign placement_y = '-0.06' %}
                      {% assign placement_z = '3.85' %}
                      {% assign placement_rotation_y = '-129' %}
                      {% else %}
                      {% assign placement_x = '3.32' %}
                      {% assign placement_y = '-0.06' %}
                      {% assign placement_z = '1.39' %}
                      {% assign placement_rotation_y = '-115' %}
                      {% endif %}

                      <div class="border rounded p-3 d-flex flex-column gap-3">
                        <h5 class="mb-0">{{ shoelace_label }}</h5>

                        <div class="d-flex flex-column gap-2">
                          <label class="fw-bold mb-0"> Position </label>

                          <div>
                            <label class="form-label small mb-1" for="{{ shoelace_key }}-x">
                              X: <span data-shoelace-mesh-value="{{ shoelace_key }}.x">{{ placement_x }}</span>
                            </label>
                            <input id="{{ shoelace_key }}-x" class="form-range" type="range" min="-5" max="5" step="0.01"
                              value="{{ placement_x }}" data-shoelace-mesh="{{ shoelace_key }}"
                              data-shoelace-mesh-slider="x">
                          </div>

                          <div>
                            <label class="form-label small mb-1" for="{{ shoelace_key }}-y">
                              Y: <span data-shoelace-mesh-value="{{ shoelace_key }}.y">{{ placement_y }}</span>
                            </label>
                            <input id="{{ shoelace_key }}-y" class="form-range" type="range" min="-5" max="5" step="0.01"
                              value="{{ placement_y }}" data-shoelace-mesh="{{ shoelace_key }}"
                              data-shoelace-mesh-slider="y">
                          </div>

                          <div>
                            <label class="form-label small mb-1" for="{{ shoelace_key }}-z">
                              Z: <span data-shoelace-mesh-value="{{ shoelace_key }}.z">{{ placement_z }}</span>
                            </label>
                            <input id="{{ shoelace_key }}-z" class="form-range" type="range" min="-5" max="5" step="0.01"
                              value="{{ placement_z }}" data-shoelace-mesh="{{ shoelace_key }}"
                              data-shoelace-mesh-slider="z">
                          </div>
                        </div>

                        <div class="d-flex flex-column gap-2">
                          <label class="fw-bold mb-0"> Rotation </label>

                          <div>
                            <label class="form-label small mb-1" for="{{ shoelace_key }}-rotation-x">
                              X: <span data-shoelace-mesh-value="{{ shoelace_key }}.rotationX">0</span>
                            </label>
                            <input id="{{ shoelace_key }}-rotation-x" class="form-range" type="range" min="-180" max="180"
                              step="1" value="0" data-shoelace-mesh="{{ shoelace_key }}"
                              data-shoelace-mesh-slider="rotationX">
                          </div>

                          <div>
                            <label class="form-label small mb-1" for="{{ shoelace_key }}-rotation-y">
                              Y: <span data-shoelace-mesh-value="{{ shoelace_key }}.rotationY">{{ placement_rotation_y
                                }}</span>
                            </label>
                            <input id="{{ shoelace_key }}-rotation-y" class="form-range" type="range" min="-180" max="180"
                              step="1" value="{{ placement_rotation_y }}" data-shoelace-mesh="{{ shoelace_key }}"
                              data-shoelace-mesh-slider="rotationY">
                          </div>

                          <div>
                            <label class="form-label small mb-1" for="{{ shoelace_key }}-rotation-z">
                              Z: <span data-shoelace-mesh-value="{{ shoelace_key }}.rotationZ">0</span>
                            </label>
                            <input id="{{ shoelace_key }}-rotation-z" class="form-range" type="range" min="-180" max="180"
                              step="1" value="0" data-shoelace-mesh="{{ shoelace_key }}"
                              data-shoelace-mesh-slider="rotationZ">
                          </div>
                        </div>
                      </div>
                      {% endfor %}
                    </div>

                    <div class="d-none flex-column gap-4" aria-hidden="true">
                      <label class="fw-bold py-2 mb-0"> Duplicate Text Placement: </label>

                      {% assign duplicate_text_shoelaces = 'shoelace_3,Shoelace 3 Text|shoelace_4,Shoelace 4 Text' |
                      split: '|' %}

                      {% for shoelace_entry in duplicate_text_shoelaces %}
                      {% assign shoelace_parts = shoelace_entry | split: ',' %}
                      {% assign shoelace_key = shoelace_parts[0] %}
                      {% assign shoelace_label = shoelace_parts[1] %}

                      <div class="border rounded p-3 d-flex flex-column gap-3">
                        <h5 class="mb-0">{{ shoelace_label }}</h5>

                        <div class="d-flex flex-column gap-2">
                          <label class="fw-bold mb-0"> Text Position </label>

                          <div>
                            <label class="form-label small mb-1" for="{{ shoelace_key }}-text-x">
                              Front X: <span data-duplicate-shoelace-text-value="{{ shoelace_key }}.x">-0.16</span>
                            </label>
                            <input id="{{ shoelace_key }}-text-x" class="form-range" type="range" min="-2" max="2"
                              step="0.01" value="-0.16" data-duplicate-shoelace-text="{{ shoelace_key }}"
                              data-duplicate-shoelace-text-slider="x">
                          </div>

                          <div>
                            <label class="form-label small mb-1" for="{{ shoelace_key }}-text-back-x">
                              Back X: <span data-duplicate-shoelace-text-value="{{ shoelace_key }}.backX">-0.185</span>
                            </label>
                            <input id="{{ shoelace_key }}-text-back-x" class="form-range" type="range" min="-2" max="2"
                              step="0.01" value="-0.185" data-duplicate-shoelace-text="{{ shoelace_key }}"
                              data-duplicate-shoelace-text-slider="backX">
                          </div>

                          <div>
                            <label class="form-label small mb-1" for="{{ shoelace_key }}-text-y">
                              Y: <span data-duplicate-shoelace-text-value="{{ shoelace_key }}.y">0.01</span>
                            </label>
                            <input id="{{ shoelace_key }}-text-y" class="form-range" type="range" min="-2" max="2"
                              step="0.01" value="0.01" data-duplicate-shoelace-text="{{ shoelace_key }}"
                              data-duplicate-shoelace-text-slider="y">
                          </div>

                          <div>
                            <label class="form-label small mb-1" for="{{ shoelace_key }}-text-z">
                              Z: <span data-duplicate-shoelace-text-value="{{ shoelace_key }}.z">-0.09</span>
                            </label>
                            <input id="{{ shoelace_key }}-text-z" class="form-range" type="range" min="-1" max="1"
                              step="0.01" value="-0.09" data-duplicate-shoelace-text="{{ shoelace_key }}"
                              data-duplicate-shoelace-text-slider="z">
                          </div>
                        </div>

                        <div class="d-flex flex-column gap-2">
                          <label class="fw-bold mb-0"> Text Rotation </label>

                          <div>
                            <label class="form-label small mb-1" for="{{ shoelace_key }}-text-rotation-x">
                              X: <span data-duplicate-shoelace-text-value="{{ shoelace_key }}.rotationX">90</span>
                            </label>
                            <input id="{{ shoelace_key }}-text-rotation-x" class="form-range" type="range" min="-180"
                              max="180" step="1" value="90" data-duplicate-shoelace-text="{{ shoelace_key }}"
                              data-duplicate-shoelace-text-slider="rotationX">
                          </div>

                          <div>
                            <label class="form-label small mb-1" for="{{ shoelace_key }}-text-rotation-y">
                              Y: <span data-duplicate-shoelace-text-value="{{ shoelace_key }}.rotationY">0</span>
                            </label>
                            <input id="{{ shoelace_key }}-text-rotation-y" class="form-range" type="range" min="-180"
                              max="180" step="1" value="0" data-duplicate-shoelace-text="{{ shoelace_key }}"
                              data-duplicate-shoelace-text-slider="rotationY">
                          </div>

                          <div>
                            <label class="form-label small mb-1" for="{{ shoelace_key }}-text-rotation-z">

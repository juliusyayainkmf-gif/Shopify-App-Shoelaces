                White
              </button>

              <button class="shoe-btn black-btn" id="shoeBlack" type="button" data-shoe-color="#3a3a3a">
                <span class="dot black"></span>
                Black
              </button>
            </div>

            <div class="text-start d-none flex-column gap-3" aria-hidden="true">
              <label class="fw-bold py-2 mb-0"> Shoelace Text 3-4 Position: </label>

              {% assign preview_text_shoelaces = 'shoelace_3,Shoelace 3 Text|shoelace_4,Shoelace 4 Text' | split: '|' %}

              {% for shoelace_entry in preview_text_shoelaces %}
                {% assign shoelace_parts = shoelace_entry | split: ',' %}
                {% assign shoelace_key = shoelace_parts[0] %}
                {% assign shoelace_label = shoelace_parts[1] %}


  import { OrbitControls } from "three/addons/controls/OrbitControls.js";
  import { TrackballControls } from "three/addons/controls/TrackballControls.js";
  import { FontLoader } from "three/addons/loaders/FontLoader.js";
  import { TextGeometry } from "three/addons/geometries/TextGeometry.js";
  import { SVGLoader } from "three/addons/loaders/SVGLoader.js";
  import { RoomEnvironment } from "three/addons/environments/RoomEnvironment.js";

  window.THREE = THREE;
  window.GLTFLoader = GLTFLoader;
  window.OrbitControls = OrbitControls;
  window.TrackballControls = TrackballControls;
  window.FontLoader = FontLoader;
  window.TextGeometry = TextGeometry;
  window.SVGLoader = SVGLoader;
  window.SVGLoaderCreateShapes = SVGLoader.createShapes;
  window.RoomEnvironment = RoomEnvironment;

  await import({{ 'shoelace-text.js' | asset_url | json }});
  await import({{ 'script.js' | asset_url | json }});
  await import({{ 'controller.js' | asset_url | json }});
  await import({{ 'draganddrop.js' | asset_url | json }});
</script>

{% schema %}
{
  "name": "Shoelaces Configurator",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Dubraes"
    },
    {
      "type": "image_picker",
      "id": "help_image",
      "label": "Help modal image"
    },
    {
      "type": "text",
      "id": "aglets_variant_id",
      "label": "Aglets variant ID",
      "info": "Variant priced at $12.99."
    },
    {
      "type": "text",
      "id": "personalization_variant_id",
      "label": "Personalization variant ID",
      "info": "Variant priced at $10.00."
    },
    {
      "type": "text",
      "id": "aglets_personalization_variant_id",
      "label": "Aglets + personalization variant ID",
      "info": "Variant priced at $17.99."
    }
  ]
}
{% endschema %}

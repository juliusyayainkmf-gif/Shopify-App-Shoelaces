                  <div>
                    <label class="form-label small mb-1" for="{{ shoelace_key }}-preview-text-back-x">
                      Back X: <span data-duplicate-shoelace-text-value="{{ shoelace_key }}.backX">0.5</span>
                    </label>
                    <input
                      id="{{ shoelace_key }}-preview-text-back-x"
                      class="form-range"
                      type="range"
                      min="-2"
                      max="2"
                      step="0.01"
                      value="0.5"
                      data-duplicate-shoelace-text="{{ shoelace_key }}"
                      data-duplicate-shoelace-text-slider="backX"
                    >
                  </div>

                  <div>
                    <label class="form-label small mb-1" for="{{ shoelace_key }}-preview-text-y">
                      Y: <span data-duplicate-shoelace-text-value="{{ shoelace_key }}.y">0.01</span>
                    </label>
                    <input
                      id="{{ shoelace_key }}-preview-text-y"
                      class="form-range"
                      type="range"
                      min="-2"
                      max="2"
                      step="0.01"
                      value="0.01"
                      data-duplicate-shoelace-text="{{ shoelace_key }}"
                      data-duplicate-shoelace-text-slider="y"
                    >
                  </div>

                  <div>
                    <label class="form-label small mb-1" for="{{ shoelace_key }}-preview-text-z">
                      Z: <span data-duplicate-shoelace-text-value="{{ shoelace_key }}.z">0.11</span>
                    </label>
                    <input
                      id="{{ shoelace_key }}-preview-text-z"
                      class="form-range"
                      type="range"
                      min="-1"
                      max="1"
                      step="0.01"
                      value="0.11"
                      data-duplicate-shoelace-text="{{ shoelace_key }}"
                      data-duplicate-shoelace-text-slider="z"
                    >
                  </div>

                  <label class="fw-bold mb-0"> Text Rotation </label>

                  <div>
                    <label class="form-label small mb-1" for="{{ shoelace_key }}-preview-text-rotation-x">
                      X: <span data-duplicate-shoelace-text-value="{{ shoelace_key }}.rotationX">-90</span>
                    </label>
                    <input
                      id="{{ shoelace_key }}-preview-text-rotation-x"
                      class="form-range"
                      type="range"
                      min="-180"
                      max="180"
                      step="1"
                      value="-90"
                      data-duplicate-shoelace-text="{{ shoelace_key }}"
                      data-duplicate-shoelace-text-slider="rotationX"
                    >
                  </div>

                  <div>
                    <label class="form-label small mb-1" for="{{ shoelace_key }}-preview-text-rotation-y">
                      Y: <span data-duplicate-shoelace-text-value="{{ shoelace_key }}.rotationY">0</span>
                    </label>
                    <input
                      id="{{ shoelace_key }}-preview-text-rotation-y"
                      class="form-range"
                      type="range"
                      min="-180"
                      max="180"
                      step="1"
                      value="0"
                      data-duplicate-shoelace-text="{{ shoelace_key }}"
                      data-duplicate-shoelace-text-slider="rotationY"
                    >
                  </div>

                  <div>
                    <label class="form-label small mb-1" for="{{ shoelace_key }}-preview-text-rotation-z">
                      Z: <span data-duplicate-shoelace-text-value="{{ shoelace_key }}.rotationZ">0</span>
                    </label>
                    <input
                      id="{{ shoelace_key }}-preview-text-rotation-z"
                      class="form-range"
                      type="range"
                      min="-180"
                      max="180"
                      step="1"
                      value="0"
                      data-duplicate-shoelace-text="{{ shoelace_key }}"
                      data-duplicate-shoelace-text-slider="rotationZ"
                    >
                  </div>
                </div>
              {% endfor %}
            </div>

            <div class="text-start d-none flex-column gap-3" aria-hidden="true">
              {% assign preview_aglets = 'aglet_1,Aglet 1|aglet_2,Aglet 2|aglet_3,Aglet 3|aglet_4,Aglet 4'
                | split: '|'
              %}

              {% for aglet_entry in preview_aglets %}
                {% assign aglet_parts = aglet_entry | split: ',' %}
                {% assign aglet_key = aglet_parts[0] %}
                {% assign aglet_label = aglet_parts[1] %}
                {% if aglet_key == 'aglet_1' %}
                  {% assign aglet_x = '-0.93' %}
                  {% assign aglet_y = '0' %}
                  {% assign aglet_z = '-0.01' %}
                {% elsif aglet_key == 'aglet_2' %}
                  {% assign aglet_x = '0.93' %}
                  {% assign aglet_y = '0' %}
                  {% assign aglet_z = '0.01' %}
                {% elsif aglet_key == 'aglet_3' %}
                  {% assign aglet_x = '-0.93' %}
                  {% assign aglet_y = '0' %}
                  {% assign aglet_z = '0' %}
                {% else %}
                  {% assign aglet_x = '0.93' %}
                  {% assign aglet_y = '0' %}
                  {% assign aglet_z = '0.01' %}
                {% endif %}

                <div class="border rounded p-3 d-flex flex-column gap-3">
                  <h5 class="mb-0">{{ aglet_label }}</h5>

                  <div class="d-flex flex-column gap-2">

                    <label for="shoelace-color" class="fw-bold py-2"> Apply To: </label>

                    <div class="color-target-group d-flex gap-2 flex-wrap mb-3">
                      {% comment %}
                        <button type="button" class="color-target-btn btn btn-dark btn-sm"
                        data-target="all">All</button>
                      {% endcomment %}

                      <button type="button" class="color-target-btn btn btn-dark btn-active active" data-target="model">
                        Laces
                      </button>

                      <button type="button" class="color-target-btn btn btn-outline-dark" data-target="text">
                        Text
                      </button>

                      <button type="button" class="color-target-btn btn btn-outline-dark" data-target="emoji">

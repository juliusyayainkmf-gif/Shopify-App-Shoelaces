                      </label>
                      <input
                        id="{{ aglet_key }}-preview-x"
                        class="form-range"
                        type="range"
                        min="-2"
                        max="2"
                        step="0.01"
                        value="{{ aglet_x }}"
                        data-aglet-mesh="{{ aglet_key }}"
                        data-aglet-mesh-slider="x"
                      >
                    </div>

                    <div>
                      <label class="form-label small mb-1" for="{{ aglet_key }}-preview-y">
                        Y: <span data-aglet-mesh-value="{{ aglet_key }}.y">{{ aglet_y }}</span>
                      </label>
                      <input
                        id="{{ aglet_key }}-preview-y"
                        class="form-range"
                        type="range"
                        min="-2"
                        max="2"
                        step="0.01"
                        value="{{ aglet_y }}"
                        data-aglet-mesh="{{ aglet_key }}"
                        data-aglet-mesh-slider="y"
                      >
                    </div>

                    <div>
                      <label class="form-label small mb-1" for="{{ aglet_key }}-preview-z">
                        Z: <span data-aglet-mesh-value="{{ aglet_key }}.z">{{ aglet_z }}</span>
                      </label>
                      <input
                        id="{{ aglet_key }}-preview-z"
                        class="form-range"
                        type="range"
                        min="-2"
                        max="2"
                        step="0.01"
                        value="{{ aglet_z }}"
                        data-aglet-mesh="{{ aglet_key }}"
                        data-aglet-mesh-slider="z"
                      >
                    </div>
                  </div>

                  <div class="d-flex flex-column gap-2">
                    <label class="fw-bold mb-0">Rotation</label>

                    <div>
                      <label class="form-label small mb-1" for="{{ aglet_key }}-preview-rotation-x">
                        X: <span data-aglet-mesh-value="{{ aglet_key }}.rotationX">0</span>
                      </label>
                      <input
                        id="{{ aglet_key }}-preview-rotation-x"
                        class="form-range"
                        type="range"
                        min="-180"
                        max="180"
                        step="1"
                        value="0"
                        data-aglet-mesh="{{ aglet_key }}"
                        data-aglet-mesh-slider="rotationX"
                      >
                    </div>

                    <div>
                      <label class="form-label small mb-1" for="{{ aglet_key }}-preview-rotation-y">
                        Y: <span data-aglet-mesh-value="{{ aglet_key }}.rotationY">0</span>
                      </label>
                      <input
                        id="{{ aglet_key }}-preview-rotation-y"
                        class="form-range"
                        type="range"
                        min="-180"
                        max="180"
                        step="1"
                        value="0"
                        data-aglet-mesh="{{ aglet_key }}"
                        data-aglet-mesh-slider="rotationY"
                      >
                    </div>

                    <div>
                      <label class="form-label small mb-1" for="{{ aglet_key }}-preview-rotation-z">
                        Z: <span data-aglet-mesh-value="{{ aglet_key }}.rotationZ">0</span>
                      </label>
                      <input
                        id="{{ aglet_key }}-preview-rotation-z"
                        class="form-range"
                        type="range"
                        min="-180"
                        max="180"
                        step="1"
                        value="0"
                        data-aglet-mesh="{{ aglet_key }}"
                        data-aglet-mesh-slider="rotationZ"
                      >
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>

        <div class="price pb-4">
          <h3 class="d-flex justify-content-between">
            <span>Estimated Total: </span>
            <span id="price-tag">$5.00</span>
          </h3>

          <p class="mb-4">Taxes, discounts and shipping calculated at checkout.</p>

          <div class="d-flex gap-3">
            <button class="btn btn-outline-dark option-btn btn-active w-100 py-3" id="summaryBtn" type="button">
              Summary
            </button>

            <button class="btn btn-outline-dark option-btn btn-active w-100 py-3" id="addToCart" type="button">
              Add To Cart
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex w-100 h-100 position-absolute z-3" id="addToCartStatus">
    <div
      class="border rounded addToCartStatus-container bg-white text-center p-5 position-fixed top-50 start-50 late-middle"
    >
      <h3 id="cartStatusTitle">Item added to your cart!</h3>
      <h3 id="cartStatusMessage">You can continue shopping or checkout.</h3>
